# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # только сервер: воркер outbox и webhook

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=            # любая строка [A-Za-z0-9_-]{1,256}, сверяется с X-Telegram-Bot-Api-Secret-Token
TELEGRAM_TEAM_CHAT_ID=              # общий чат команды, если у записи outbox chat_id = null

# Vercel Cron присылает Authorization: Bearer $CRON_SECRET
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=https://status-models.com
