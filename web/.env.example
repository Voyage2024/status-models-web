# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # только сервер: воркер outbox и webhook

# Telegram
# Скопируйте этот файл в .env.local (в git он не попадает) и заполните; на Vercel те же ключи в Environment Variables.
TELEGRAM_BOT_TOKEN=                 # от @BotFather
TELEGRAM_CHAT_ID=                   # чат букеров/скаутов для новых анкет; узнать: добавить бота в чат и отправить /id
TELEGRAM_WEBHOOK_SECRET=            # любая строка [A-Za-z0-9_-]{1,256}, сверяется с X-Telegram-Bot-Api-Secret-Token
TELEGRAM_ADMIN_LOCALE=ru            # язык админки в кнопке «Открыть в админке»: ru или en

# Vercel Cron присылает Authorization: Bearer $CRON_SECRET
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=https://status-models.com
